# Generic Dockerfile for Python FastAPI services
# Optimized to support Docker layer caching and CPU-only builds for disk savings

FROM python:3.11-slim

WORKDIR /app
ENV PYTHONPATH=/app:/app/libs:/app/services

# Install system dependencies (combined for all services: compilation, OCR, PDFs, healthcheck)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        build-essential \
        cmake \
        libgl1 \
        libglib2.0-0 \
        libsm6 \
        libxrender1 \
        libxext6 \
        poppler-utils \
        tesseract-ocr \
        libtesseract-dev \
    && rm -rf /var/lib/apt/lists/*

# Increase pip timeout and retries to handle large dependency installs
ENV PIP_DEFAULT_TIMEOUT=300
ENV PIP_RETRIES=10

# Pre-install CPU-only PyTorch & PaddlePaddle to avoid pulling CUDA binaries (saves 10GB+ space)
RUN pip install --upgrade pip && \
    pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir paddlepaddle -i https://www.paddlepaddle.org.cn/packages/stable/cpu/

# Install the unified root requirements (cached across all builds)
COPY requirements.txt /app/
RUN pip install --no-cache-dir -r requirements.txt

# Now introduce the ARG and copy service-specific code
ARG SERVICE_NAME
ENV SERVICE_NAME=${SERVICE_NAME}

# Copy shared libs
COPY libs/ /app/libs/

# Copy all services for Celery autodiscovery and imports
COPY services/ /app/services/

# Copy service code (for FastAPI entrypoint)
COPY services/${SERVICE_NAME}/app/ /app/app/

# Create storage directory (used by ingress)
RUN mkdir -p /app/storage/raw

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
